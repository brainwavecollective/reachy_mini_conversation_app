{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline Action",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "steps"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "head_tracking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "backend": { "type": "string", "enum": ["yolo", "mediapipe"] }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "move": { "$ref": "#/$defs/NameOrPicker" },
          "sound": { "$ref": "#/$defs/FileOrPicker" },
          "reactive_sound": { "$ref": "#/$defs/FileOrPicker" },
          "repeat": { "type": "integer", "minimum": 1, "default": 1 },
          "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
          "latency": { "type": "number", "minimum": 0, "default": 0.08 },
          "duration": { "type": "number", "minimum": 0 }
        },
        "oneOf": [
          { "required": ["move"], "not": { "anyOf": [ { "required": ["sound"] }, { "required": ["reactive_sound"] } ] } },
          { "required": ["sound"], "not": { "anyOf": [ { "required": ["move"] }, { "required": ["reactive_sound"] } ] } },
          { "required": ["reactive_sound"], "not": { "anyOf": [ { "required": ["move"] }, { "required": ["sound"] } ] } }
        ]
      }
    }
  },
  "$defs": {
    "Picker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "additionalProperties": false, "properties": { "name": { "type": "string" }, "file": { "type": "string" }, "weight": { "type": "number", "minimum": 0 } } }
            ]
          }
        },
        "strategy": { "type": "string", "enum": ["random", "weighted_random", "round_robin"], "default": "random" }
      },
      "required": ["items"]
    },
    "NameOrPicker": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "properties": { "pick": { "$ref": "#/$defs/Picker" } }, "required": ["pick"], "additionalProperties": false }
      ]
    },
    "FileOrPicker": {
      "oneOf": [
        { "type": "string" },
        { "type": "object", "properties": { "pick": { "$ref": "#/$defs/Picker" } }, "required": ["pick"], "additionalProperties": false }
      ]
    }
  }
}

